(in-package #:cl-user)
(defpackage #:sample-project/test/string-utils
  (:use #:cl
        #:rove
        #:sample-project/string-utils))
(in-package #:sample-project/test/string-utils)

(deftest join-string-test
  (ok (string= (join-strings '("a" "b" "c") ", ")
               "a, b, c"))
  (ok (string= (join-strings '("hello") "-")
               "hello")))

(deftest repeat-string-test
  (ok (string= (repeat-string "ab" 3) "ababab"))
  (ok (string= (repeat-string "x" 1) "x"))
  (ok (string= (repeat-string "a" 0) "")))

(deftest truncate-string-test
  (ok (string= (truncate-string "Hello, World!" 5)
               "Hello..."))
  (ok (string= (truncate-string "Hi" 10)
               "Hi")))

(deftest greet-test
  (ok (string= (greet "Alice")
               "Hello, Alice!")
      "Default greeting should be Hello")
  (ok (string= (greet "Bob" "Hi")
               "Hi, Bob!")
      "Custom greeting should work")
  (ok (string= (greet "Charlie" "Hey" "How are you?")
               "Hey, Charlie! How are you?")
      "Optional suffix without default value should work"))

(deftest format-name-test
  (ok (string= (format-name "John" "Doe")
               "John Doe")
      "Default format should be western with space separator")
  (ok (string= (format-name "John" "Doe" :separator ", ")
               "John, Doe")
      "Custom separator should work")
  (ok (string= (format-name "Taro" "Yamada" :order :eastern)
               "Yamada Taro")
      "Eastern order should put last name first")
  (ok (string= (format-name "Taro" "Yamada" :separator "・" :order :eastern)
               "Yamada・Taro")
      "Both keyword args should work together"))

(deftest concat-all-test
  (ok (string= (concat-all ", " "a" "b" "c")
               "a, b, c")
      "Multiple &rest args should be joined")
  (ok (string= (concat-all "-" "hello")
               "hello")
      "Single &rest arg should work")
  (ok (string= (concat-all ", ")
               "")
      "No &rest args should return empty string"))

