;;; -*- mode: lisp -*-
(in-package #:sample-project/test-fiveam)

(def-suite string-utils-suite
  :in sample-project-suite
  :description "String utilities tests")

(in-suite string-utils-suite)

(test join-strings-test
  (is (string= (sample-project/string-utils:join-strings '("a" "b" "c") ", ")
               "a, b, c"))
  (is (string= (sample-project/string-utils:join-strings '("hello") "-")
               "hello")))

(test repeat-string-test
  (is (string= (sample-project/string-utils:repeat-string "ab" 3) "ababab"))
  (is (string= (sample-project/string-utils:repeat-string "x" 1) "x"))
  (is (string= (sample-project/string-utils:repeat-string "a" 0) "")))

(test truncate-string-test
  (is (string= (sample-project/string-utils:truncate-string "Hello, World!" 5)
               "Hello..."))
  (is (string= (sample-project/string-utils:truncate-string "Hi" 10)
               "Hi")))

(test greet-test
  (is (string= (sample-project/string-utils:greet "Alice")
               "Hello, Alice!")
      "Default greeting should be Hello")
  (is (string= (sample-project/string-utils:greet "Bob" "Hi")
               "Hi, Bob!")
      "Custom greeting should work")
  (is (string= (sample-project/string-utils:greet "Charlie" "Hey" "How are you?")
               "Hey, Charlie! How are you?")
      "Optional suffix without default value should work"))

(test format-name-test
  (is (string= (sample-project/string-utils:format-name "John" "Doe")
               "John Doe")
      "Default format should be western with space separator")
  (is (string= (sample-project/string-utils:format-name "John" "Doe" :separator ", ")
               "John, Doe")
      "Custom separator should work")
  (is (string= (sample-project/string-utils:format-name "Taro" "Yamada" :order :eastern)
               "Yamada Taro")
      "Eastern order should put last name first")
  (is (string= (sample-project/string-utils:format-name "Taro" "Yamada" :separator "・" :order :eastern)
               "Yamada・Taro")
      "Both keyword args should work together"))

