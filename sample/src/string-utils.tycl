;;; -*- mode: lisp -*-
;;;; Sample Project - String Utilities (TyCL)

(in-package #:cl-user)
(defpackage #:sample-project/string-utils
  (:use #:cl)
  (:export #:join-strings
           #:repeat-string
           #:truncate-string
           #:greet
           #:format-name))
(in-package #:sample-project/string-utils)

(defun [join-strings :string] ([strings :list] [separator :string])
  "Join a list of strings with a separator"
  (format nil (concatenate 'string "~{~A~^" separator "~}") strings))

(defun [repeat-string :string] ([s :string] [n :integer])
  "Repeat a string n times"
  (apply #'concatenate 'string (make-list n :initial-element s)))

(defun [truncate-string :string] ([s :string] [max-length :integer])
  "Truncate a string to max-length, adding ... if truncated"
  (if (<= (length s) max-length)
      s
      (concatenate 'string (subseq s 0 max-length) "...")))

(defun [greet :string] ([name :string] &optional ([greeting :string] "Hello") [suffix (:string :null)])
  "Greet someone with an optional greeting prefix and suffix"
  (let ((base (concatenate 'string greeting ", " name "!")))
    (if suffix
        (concatenate 'string base " " suffix)
        base)))

(defun [format-name :string] ([first-name :string] [last-name :string]
                               &key ([separator :string] " ") ([order :keyword] :western))
  "Format a full name with optional separator and order"
  (if (eq order :eastern)
      (concatenate 'string last-name separator first-name)
      (concatenate 'string first-name separator last-name)))

